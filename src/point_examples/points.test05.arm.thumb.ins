INSERT BEFORE [print_info] CALLSITE [] "arm-linux-gnueabihf-gcc -no-pie -c ./instr_modules/c/fun.c" C before_print_info ./instr_modules/c/fun.c;
INSERT AFTER [print_info] FUNENTRY [] "arm-linux-gnueabihf-gcc -no-pie -c ./instr_modules/c/fun.c" C log_execution_times ./instr_modules/c/fun.c;
INSERT BEFORE [print_info] FUNEXIT [] "arm-linux-gnueabihf-gcc -no-pie -c ./instr_modules/c/fun.c" C log_execution_times ./instr_modules/c/fun.c;
INSERT AFTER [print_info] FUNENTRY [] "" asm x
"mov r1, 0
mov r1, 0
mov r1, 0";
INSERT BEFORE [print_info] FUNEXIT [] "" asm x
"mov r1, 0
mov r1, 0
mov r1, 0";
INSERT AFTER [main] FUNENTRY [] "arm-linux-gnueabihf-gcc -no-pie -c ./instr_modules/c/print_filename.c" C print_filename ./instr_modules/c/print_filename.c; # print the filename at the beginning of main
