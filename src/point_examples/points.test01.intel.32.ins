user instr_modules/instr_asm.ml; # instrument_locs.ins contains one line that is address "0x804919d" to insert assembly at. The assembly to insert is defined in the file generic_instr_asm.asm
user instr_modules/instr_c.ml; # instrument_locs.ins contains one line that is address "0x804919d" to insert compiled C code at. The C code to insert is defined in the file generic_instr_fun.c
INSERT AFTER [main] FUNENTRY [] "gcc -no-pie -c ./instr_modules/c/print_filename.c -m32" C print_filename ./instr_modules/c/print_filename.c; # print the filename at the beginning of main
