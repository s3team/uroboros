INSERT BEFORE [decrypt_file] CALLSITE [] "gcc -no-pie -m32 -c ./instr_modules/c/fun.c" C log_execution_times ./instr_modules/c/fun.c;
INSERT AFTER [main] FUNENTRY [] "gcc -no-pie -c ./instr_modules/c/print_filename.c -m32" C print_filename ./instr_modules/c/print_filename.c; # print the filename at the beginning of main
