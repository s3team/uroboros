INSERT BEFORE [getrandom] CALLSITE [] "" ASM x "pop $rsi
pop $rdi";
INSERT BEFORE [getrandom] CALLSITE [] "gcc -no-pie -c ./instr_modules/c/fun.c" C print_int ./instr_modules/c/fun.c;
INSERT BEFORE [getrandom] CALLSITE [] "" ASM x "push $rdi
push $rsi
mov $rsi, $rdi";
INSERT AFTER [main] FUNENTRY [] "gcc -no-pie -c ./instr_modules/c/print_filename.c" C print_filename ./instr_modules/c/print_filename.c; # print the filename at the beginning of main
